{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@arminmajerie/dockview": ["../dockview/dist/index.d.ts", "../dockview/src/index.ts"],
      "@arminmajerie/dockview/*": ["../dockview/dist/*", "../dockview/src/*"]
    }
  },
  "include": ["src"]
}
