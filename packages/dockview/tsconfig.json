// packages/dockview/tsconfig.json
{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@arminmajerie/dockview-core": [
        "../dockview-core/dist/cjs/index.d.ts",
        "../dockview-core/src/index.ts"
      ]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
