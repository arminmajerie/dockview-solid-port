{
  "name": "dockview-solid-port",
  "private": true,
  "description": "Monorepo for dockview-solid-port: a modern SolidJS wrapper for Dockview with no React dependency",
  "homepage": "https://github.com/arminmajerie/dockview-solid-port#readme",
  "bugs": {
    "url": "https://github.com/arminmajerie/dockview-solid-port/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arminmajerie/dockview-solid-port.git"
  },
  "license": "MIT",
  "author": "https://github.com/arminmajerie",
  "workspaces": [
    "packages/dockview",
    "packages/dockview-solid",
    "packages/dockview-core",
    "dockview-solid-example"
  ],
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@types/jest": "^29.5.14",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "gulp": "^5.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-sonar-reporter": "^2.0.0",
    "gulp-sass": "^6.0.1",
    "lerna": "^8.2.1",
    "rimraf": "^5.0.5",
    "sass": "^1.93.2",
    "solid-js": "^1.8.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typedoc": "^0.28",
    "typescript": "^5.3.3",
    "vite": "^5.1.5",
    "vite-plugin-solid": "^2.11.8"
  },
  "engines": {
    "node": ">=18.0"
  },
  "scripts": {
    "publish:dockview": "npm publish -w @arminmajerie/dockview --access public",
    "publish:dockview-core": "npm publish -w @arminmajerie/dockview-core --access public",
    "publish:dockview-solid": "npm publish -w @arminmajerie/dockview-solid --access public",

    "clean": "lerna run clean",
    "build": "lerna run build --stream",
    "build:ordered": "npm run build -w packages/dockview-core && npm run build -w packages/dockview && npm run build -w packages/dockview-solid",
    "build:example": "npm --prefix packages/dockview-solid-example run build",
    "dev": "lerna run dev --stream",
    "dev:example": "npm --prefix packages/dockview-solid-example run dev",
    "lint": "eslint 'packages/*/src/**/*.{ts,tsx,js,jsx}'",
    "lint:fix": "eslint 'packages/*/src/**/*.{ts,tsx,js,jsx}' --fix",
    "docs": "typedoc && node scripts/docs.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "npm --prefix packages/dockview-core run test:unit",
    "test:integration": "npm --prefix packages/dockview-core run test:integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "version": "lerna version",
    "example": "cd packages/dockview-solid-example && npm run server"
  }
}
